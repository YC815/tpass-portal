# tpass-portal（portal，消費端）環境變數範本。
# 複製成 .env.local 後填值；.env.local 不進 git。
# 消費端只需要「對接 auth 的最少資訊」+ 公鑰來源（JWKS）。絕不放任何私鑰。
# 來源：src/config/portal.ts（REQUIRED 清單）+ server.mjs（本機 HTTPS 啟動變數）。

# ── 對接 auth（本機值 → 上線改成正式網域，邏輯不動）─────────────────
# 本機： https://auth.lvh.me:3000   上線： https://auth.tschoolsu.org（無 port）
AUTH_JWKS_URL=https://auth.lvh.me:3000/.well-known/jwks.json
AUTH_AUTHORIZE_URL=https://auth.lvh.me:3000/api/auth/authorize
AUTH_LOGOUT_URL=https://auth.lvh.me:3000/api/auth/logout

# 本服務自己的完整網址（callback / 登出導回用）。
# 本機： https://portal.lvh.me:3001   上線： https://portal.tschoolsu.org
PORTAL_SELF_URL=https://portal.lvh.me:3001

# 契約 v2：本服務登記的服務 id（＝ tpass-ops services.json 的 id；須在 auth 的
# AUTH_SERVICE_IDS 白名單內）。驗章 audience = tpass:<此 id>，程式自動派生。
TPASS_SERVICE_ID=portal

# 驗章要與 auth 簽發端完全一致（含 port、無多餘斜線）。
# 本機： https://auth.lvh.me:3000   上線：隨 auth 正式網域改
JWT_ISSUER=https://auth.lvh.me:3000

# ── 本機 HTTPS 啟動（server.mjs 用；上線走 nginx + next start，不設這三項）──
PORT=3001
HOSTNAME=portal.lvh.me
# 指向 tpass setup 產的共用憑證（用絕對路徑最穩）。
TLS_KEY_FILE=../certs/key.pem
TLS_CERT_FILE=../certs/cert.pem

# 門戶發射台的服務卡片網址（一律 env 驅動，絕不寫死網域）。上線改成正式網域。
FORM_URL=https://form.lvh.me:3002
MSG_URL=https://msg.lvh.me:3003
APPEALS_URL=https://appeals.lvh.me:3004

# 選填：ban 頁網址；未設就用 AUTH_AUTHORIZE_URL 的 origin + /denied（本機/正式站通常不用另外設）
# AUTH_DENIED_URL=https://auth.lvh.me:3000/denied
